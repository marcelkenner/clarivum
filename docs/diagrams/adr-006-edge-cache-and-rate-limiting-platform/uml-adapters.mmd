```mermaid
classDiagram
    class EdgeResponseCache {
        +get(key, fetcher)
        +set(key, value, ttl)
        -gateway: CacheGatewayClient
    }
    class RateLimiterManager {
        +consume(key, policy)
        +remaining(key)
        -client: ElastiCacheDataClient
    }
    class DistributedLockCoordinator {
        +acquire(key, ttl)
        +release(key)
        -client: ElastiCacheDataClient
    }
    class CacheGatewayClient {
        +fetch(method, path, payload)
    }
    class ElastiCacheDataClient {
        +execute(command, args)
        +pipeline(commands)
    }
    EdgeResponseCache --> CacheGatewayClient
    CacheGatewayClient --> ElastiCacheDataClient
    RateLimiterManager --> ElastiCacheDataClient
    DistributedLockCoordinator --> ElastiCacheDataClient
```
