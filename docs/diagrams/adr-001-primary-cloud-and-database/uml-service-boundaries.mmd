    class AuroraAdapter {
        +migrateSchema()
        +enableRLS()
        +scheduleBackups()
    }
    class StorageGateway {
        +issueSignedUrl()
        +enforceLifecyclePolicy()
    }
    DeploymentCoordinator --> AppDeliveryAdapter
    DeploymentCoordinator --> AuroraAdapter
    DeploymentCoordinator --> StorageGateway
